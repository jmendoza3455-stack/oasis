# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repo.

# --- App ---
# URL pública del sitio (sin barra final). En Vercel se usa la del despliegue.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de datos (app → Postgres con RLS por request; ver lib/db.ts) ---
# Producción: pooler de Supabase con el rol oasis_app. Local: pnpm db:local imprime la URL.
DATABASE_URL=postgres://oasis_app:oasis_local@localhost:5432/oasis_dev
# Login de desarrollo (solo local/CI; nunca funciona en Vercel)
OASIS_DEV_AUTH=1
# Venue activo en la UI (modelo multi-espacio)
OASIS_VENUE_SLUG=oasis-pachacamac
# Sal para el hash de IP del rate limiting
RATE_LIMIT_SALT=

# --- Supabase ---
# Proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (scripts, cron, acciones de admin). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Proyecto y token personal para scripts/db-push.mts (Management API)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Cadena de conexión Postgres para migraciones y backups (pg_dump en GitHub Actions).
SUPABASE_DB_URL=

# --- Tests de BD (Postgres local o servicio de CI) ---
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Backups (secretos de GitHub Actions, no de la app) ---
# SUPABASE_DB_URL y BACKUP_PASSPHRASE se configuran en GitHub > Settings > Secrets.

# --- Usuarios iniciales (scripts/create-users) ---
ADMIN_EMAILS=            # separados por coma: André y Carlos
OPS_EMAILS=              # separados por coma

# --- Correo (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=              # p.ej. "El Oasis <reservas@dominio>" (dominio por definir)

# --- Antispam (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tracking ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# --- Contacto comercial ---
NEXT_PUBLIC_WHATSAPP_NUMBER=   # formato internacional sin +, p.ej. 51999999999

# --- Agentes (docs/agentes.md) ---
# Recepcionista del chat web: se activa solo con ambas variables. Tope de gasto en settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Proveedor simulado para local/CI (nunca funciona en Vercel). Debe estar también en el build.
OASIS_AGENT_FAKE=

# --- Seguridad de crons / webhooks ---
# Vercel Cron lo envía como `Authorization: Bearer …` a /api/cron/* (vercel.json)
CRON_SECRET=
# Firma de la URL secreta del feed iCal (/admin/avisos). Rotarla invalida las suscripciones.
ICAL_SECRET=
# Firma de los enlaces de encuesta NPS
NPS_SECRET=
